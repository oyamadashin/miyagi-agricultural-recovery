@article{ZhongCunNongYeFaRennoZhanKaitoDiYu2019,
  title = {農業法人の展開と地域},
  author = {中村, 勝則},
  year = 2019,
  journal = {農村経済研究},
  volume = {37},
  number = {1},
  pages = {31--41},
  doi = {10.11617/jrse.37.1_31},
  abstract = {農家数が減少を続ける中，農業法人数とその経営面積シェアは確実に増加してきている．本稿の目的は，東北地域における次の3法人を対象に，地域における役割と今後の展望を明らかにすることである．一つは集落を越えて農地を集積するA法人．二つは集落をベースに農地を集積するB法人．三つは多角化を進めるC法人である．これら事例を，\ding{172}農地集積と資源保全管理，\ding{173}雇用の実態，\ding{174}地域内における事業体等との原材料や農産物の取引関係という観点から検討した．その結果，地域における農業法人の役割として次の諸点を導出した．第一に，農業法人が雇用を通じて周辺住民に所得獲得の機会を提供していること．第二に，脱農化が進む中で，農地を集積することを通じて地域の農地荒廃の防波堤となっていること．第三に，地域内の経済循環を担う主体となっていること．第四に，資源保全の重要な担い手となっていること．また，近い将来における展望は次のとおりである．第一に，個別農家もしくは複数の農家によって設立された「農家発」の農業法人が，農業生産のみならず地域経済の要衝になりうること．地域経済の横の連関形成にとって重要である．第二に，その事業展開を支える資源保全やコミュニティ活動の再編が必要になること．},
  keywords = {done}
}

@article{ZhongLiGongChengXianBeiZaiNongCunDiYuniokeruTuDiLiYongZhengXuHuaniXiangketaZiZhiTinoZuZhiDuiYingniGuanwaruShimitoJiaoXun2017,
  title = {宮城県被災農村地域における土地利用整序化に向けた自治体の組織対応に関わる試みと教訓},
  author = {中里, 舜 and 橋本, 禅 and 岸岡, 智也 and 有田, 博之 and 郷古, 雅春},
  year = 2017,
  journal = {農村計画学会誌},
  volume = {35},
  number = {4},
  pages = {514--520},
  doi = {10.2750/arp.35.514},
  abstract = {This study explored local governments' efforts of land use coordination in the disaster affected rural areas of Miyagi, taking Suginoshita district and Yamamoto eastern district as a study area. Major challenges faced by the two districts are two folds. The first is the fact that multiple reconstruction projects have been implemented in parallel in one district, causing the issue of inter-program coordination. The other is the existence of many plots of non-agricultural land which were not purchased by a municipal government when the government implemented the collective relocation of residences. This study argued the nature of these challenges in the disaster-affected areas and how land consolidation projects could contribute to deal with these challenges.}
}


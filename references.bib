  author = {平口, 嘉典 and 安江, 紘幸 and 大室, 健治 and 稲泉, 博己},
  year = 2016,
  journal = {農業経済研究},
  volume = {87},
  number = {4},
  pages = {424--429},
  doi = {10.11472/nokei.87.424},
  abstract = {The objective of this study is to clarify a role taken by the activity of local entertainment as a community of practice for sustaining and developing rural areas at "O" district in Rikuzentakata City, Iwate Prefecture, Japan, From interviews of members who preserve the local entertainment, the following four points were revealed: firstly, the lore process of the art was double-linear; secondly, the art had been handed down along with the physicality; thirdly, members had obtained the four learning through the activities; fourth, all members hoped to continue for the future of the activities.}
}

@article{PingKouZhuMinZhuDaoXingNongBonoQuZuKeTitoZhanKaiFangXiang2023,
  title = {住民主導型農泊の取組課題と展開方向},
  author = {平口, 嘉典 and 福田, 竜一},
  year = 2023,
  journal = {農業経済研究},
  volume = {94},
  number = {4},
  pages = {263--268},
  doi = {10.11472/nokei.94.263},
  abstract = {This study aimed to examine the issues and development directions concerning farm stays led by residents in Saikai City of Nagasaki Prefecture, Japan. The main outcomes were as follows: first, the financial situation of the secretariat was severe, and administrative support was indispensable. Second, due to the influence of COVID-19, the income from educational trips decreased sharply in comparison to that from tourism. Third, to maintain the secretariat, it was deemed necessary to attract tourists. The development directions involved creating full-time farm stays and promoting them under the regional management organization.},
  keywords = {done}
}

@article{PingLinDuFuXianniokeruDaoZuoJingYingTinoDongXiang2023,
  title = {都府県における稲作経営体の動向},
  author = {平林, 光幸},
  year = 2023,
  journal = {農業問題研究},
  volume = {54},
  number = {2},
  pages = {28--39},
  doi = {10.24808/nomonken.54.2_28},
  abstract = {本稿の目的は，近年における大規模稲作経営体，特に集落営農組織の動向を，農業センサスを利用して明らかにすることである．まず，近年まで組織経営体数が増加し，これらの経営体が地域農業の担い手として期待されてきた．しかし，2020年農業センサスでは組織経営体の増加数は鈍化し，大規模家族経営体数が著しく増加した．つまりこれまでの傾向から変化した．稲作農業における組織経営体の多くは集落営農組織である．そこで，集落営農組織の動向について分析を行った．その結果，法人化は一定程度見られるものの，経営の複合化，多角化などの経営展開は見られなかった．また経営主年齢が高齢化しており，経営を引き継ぐ後継者の確保が急務であると言える．今後は複数組織による連携，異業種との連携交流によって，経営発展が必要であると考えられる．}
}


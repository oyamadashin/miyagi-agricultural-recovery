@article{JingBanNongDiQuYinmekanizumunoZhuLeiXingtoFeiShiChangDeQuYinnoShiTai2017,
  title = {農地取引メカニズムの諸類型と非市場的取引の実態},
  author = {井坂, 友美},
  year = 2017,
  journal = {農業経済研究},
  volume = {89},
  number = {1},
  pages = {32--49},
  doi = {10.11472/nokei.89.32},
  abstract = {本稿は，農地取引をめぐる社会関係に着目し，農地取引メカニズムを理論的に整理し，その実態を明らかにした．理論的整理にあたっては，「取引の決定原理」と「取引参加者のメンバーシップ」の観点から，「非市場的」，「組織的」，「中間的」，「市場的」メカニズムに類型化した．さらに，「非市場的」取引の実態を明らかにするため，茨城県の大規模個別農家3経営を調査対象として，取引参加者間の具体的な相互関係，および，社会関係の種類ごとの取引の決定原理を実証した．農村社会における地主と借り手の農地取引のほとんどが，信頼を伴う非匿名的な関係を通して成立しており，必ずしも自由な交換とはいえないものであった．}
}


@article{YouBenQuHuanoJiaoHuanniyoruNongDinoTuanDiHuahaKeNengka2014,
  title = {区画の交換による農地の団地化は可能か？},
  author = {有本, 寛 and 中嶋, 晋作 and 富田, 康治},
  year = 2014,
  journal = {農業経済研究},
  volume = {86},
  number = {3},
  pages = {193--206},
  doi = {10.11472/nokei.86.193},
  abstract = {本稿は，区画交換による農地の団地化がどの程度可能かを，シミュレーションによって検証する．まず，現在一部の農家で行われている個別・分権的な相対交換では，自発的な交換に必要な「欲求の二重一致」が少なすぎるため，団地化の進展が困難であることを示す．次に，Shapleyらのtop trading cycleアルゴリズムを援用し，複数の農家が区画を一斉交換する集団・集権的な方法を提案する．これは，「欲求の二重一致」の制約を緩和するため，個別・分権的な交換に比べて倍以上の集団化率を実現できた．また，より多くの農家が交換に参加するほど，集団化率も劇的に高まった．多くの農家の参加を募り，集団・集権的な配分を行うことが農地の団地化にあたって有効である．}
}

@article{YouTianDaGuiMoZhenZaiFuJiuFuXingShiniokeruXianChangZhinoZuZhiDeJiLunoTiAn2020,
  title = {大規模震災復旧・復興時における現場知の組織的記録の提案},
  author = {有田, 博之 and 橋本, 禅 and 友正, 達美 and 小野, 邦雄 and 福与, 徳文 and 中島, 正裕 and 内川, 義行 and 千葉, 克己 and 落合, 基継 and 郷古, 雅春 and 田村, 孝浩 and 服部, 俊宏},
  year = 2020,
  journal = {農村計画学会誌},
  volume = {38},
  number = {4},
  pages = {468--476},
  doi = {10.2750/arp.38.468},
  abstract = {Eventuality is continuous in the restoration work following large-scale earthquake disasters. While the government officials in charge of the restoration work are in a difficult situation, both they and response workers create practical measures and ingenuity, awareness, and lessons learned to solve problems at hand. The authors refer to such wisdom acquired through practical experience as on-site knowledge. Such knowledge tends to be limited to individuals and even small circles of groups, but if it is widely shared among engineers, its effect upon problem-solving potential at disaster restoration sites is great. At present, most on-site knowledge is consumed in a small area and is tends to be forgotten without being recorded. However, since large-scale disasters are highly unique and rare, and because the same conditions are poorly reproducible, active and conscious recording of on-site knowledge is indispensable for appropriate and effective recovery efforts following future disasters. The purpose of this paper is to establish a basic understanding that will lead to the accumulation of on-site knowledge for future use, based on the experience of recording on-site knowledge in the department of agricultural and rural development during disaster restoration following the Great East Japan Earthquake of March 2011. For this reason, the authors define on-site knowledge by discussing its characteristics and clarifying its utility in disaster response. In addition, we will present the matters that should be considered in terms of description format and quality control in on-site knowledge documentation. We then propose a method of continuous systematic collection and management.}
}

@article{YuanBankokuShouDuQuanJiaoWainiokeru2011NianHongShuiShiYiJiangnoNongDiLiYongnoBianRong2014,
  title = {バンコク首都圏郊外における2011年洪水時以降の農地利用の変容},
  author = {原, 祐二 and 行松, 宏展 and タイターク, ダナイ and 土屋, 一彬},
  year = 2014,
  journal = {農村計画学会誌},
  volume = {33},
  number = {Special\_Issue},
  pages = {191--196},
  doi = {10.2750/arp.33.191},
  abstract = {Using Bangmaenang District in the urban fringe of Bangkok Metropolitan Region in Thailand as a case study area, this study aims at examining agricultural land-use changes after the 2011 Floods with special focus on farmers' intentions of orchard use and management. Supervised image classifications were conducted for two GeoEye-1 images (before and after the floods) in order to identify agricultural land-cover changes by the floods. In field survey, selected sample farm parcels were monitored using GPS digital camera, and farmers were interviewed about their adaptation to the floods and intentions of farmland uses along with time after the floods. The results of satellite image analysis and sample farmland monitoring showed that orchards got more serious flood damage than other farmlands including paddy fields, vegetable fields and flower farms. Orchard farmers tended to avoid replanting fruit trees because of higher initial costs and a fear of future flooding.}
}

@article{ZeTianDongBeiDiYuniokeruJiaZuJingYingtoDaGuiMoDaoZuoJingYingnoDongXiang2015,
  title = {東北地域における家族経営と大規模稲作経営の動向},
  author = {澤田, 守},
  year = 2015,
  journal = {農村経済研究},
  volume = {33},
  number = {2},
  pages = {60--69},
  doi = {10.11617/jrse.33.2_60},
  abstract = {東北地域の家族経営は，水田地帯を中心に米価の下落，兼業機会の減少によって厳しい経営環境にある．本稿では農林業センサスの集落カードと個票データの組替集計結果を用いて，第一に，各県の農業地域類型別の家族経営と農家人口の動向を分析し，第二に，大規模稲作経営の地域的な特徴とその動向について分析した．分析の結果，以下の点が明らかになった．第一に，東北地域において中山間地域を中心に農家人口の減少，農家世帯員の高齢化が急速に進み，労働力の脆弱化が進んでいること，第二に，大規模稲作経営の分析から，東北と大潟村では販売先などで稲作経営の存立状況が大きく異なること，第三に，関東以西では経営耕地面積の拡大が進んでいる一方で，東北と大潟村では規模拡大の動きが弱いこと，第四に，関東以西では組織経営が多い一方で，東北，大潟村は家族経営が主体であること，第五として，東北の家族経営では同居農業後継者が確保されているものの，農業従事している後継者が少ないことを示した．大規模稲作経営においては，経営形態，経営者年齢などについて地域的な違いが大きく，特に東北においては世代交代を迎える経営が急増することから，世代交代の促進に向けた支援が重要であることを示した．}
}

@article{ZeTianNongYeLaoDongLinoBianHuatoJingYingJiCheng2023,
  title = {農業労働力の変化と経営継承},
  author = {澤田, 守},
  year = 2023,
  journal = {農業問題研究},
  volume = {54},
  number = {2},
  pages = {17--27},
  doi = {10.24808/nomonken.54.2_17},
  abstract = {本研究では，2020年農林業センサスデータにより，2015年から2020年にかけての農業労働力の変化の動向と農業経営の経営継承について分析し，以下の特徴を明らかにした．第一に，農業経営の世代交代の停滞である．農業経営体の経営者数は，これまでの傾向と同様に減少している．特に，2020年農林業センサスで１は，農家世帯員の農業従事が低下しており，今後，農業経営の世代交代が停滞すると考えられる．第二に，国内農業における農業法人のシェアの増加である．豚，鶏などの中小家畜では，農業法人が農業生産の大部分を占めている．第三に，一部の農業経営体において常雇人数の増加がみられる．2015年から2020年にかけては，全体的に常雇人数が大きく減少した．しかし，常雇人数が多い一部の農業経営体では，常雇人数を増やし，規模拡大する傾向がみられる．第四に，個人経営体だけではなく，農業法人においても経営者が高齢化しており，後継者不在の農業法人は30％以上を占めている．以上の結果からは，個人経営体の減少が進んでいる一方で，農業法人においても経営継承が困難な経営体が多く，継承対策が喫緊の課題となっている．}
}

@article{ZeTianNongYesensasudetaHuoYongniyoruNongYeGouZaoBianDongFenXinoDongXiangtoZhanWang2023,
  title = {農業センサスデータ活用による農業構造変動分析の動向と展望},
  author = {澤田, 守},
  year = 2023,
  journal = {農業経済研究},
  volume = {95},
  number = {3},
  pages = {123--134},
  doi = {10.11472/nokei.95.123},
  abstract = {The purpose of this paper is to review research on farm structure issues using agricultural census data. From the 1970s to the 1980s, these studies presented different perspectives on the trend of small-scale farmers quitting farming and the trend of large-scale farmers expanding their scale. The factor analysis of farm structure has decreased since 2000 due to changes in survey methodology and the impact of policy changes. The future research perspective should include: first, the development of analysis of changes in farm structure through microdata analysis, second, analyzing the factors of changes in farm management by long-term panel data analysis, and third, analyzing regional farm structure by linkage with other statistics.},
  keywords = {done}
}


@article{DuBianNongYeFaRenniokeruCongYeYuannowakuengeizimentoXiangShangnoYiYitoGuanLianYaoYin2024,
  title = {農業法人における従業員のワーク・エンゲイジメント向上の意義と関連要因},
  author = {渡辺, 日奈乃 and 角田, 毅 and {Eustadius Francis MAGEZI}},
  year = 2024,
  journal = {農業経済研究},
  volume = {96},
  number = {3},
  pages = {379--384},
  doi = {10.11472/nokei.96.379},
  abstract = {The objective of this study is to determine the effects and factors of increasing the work engagement of employees of agricultural corporations. The main outcomes are as follows. First, work engagement positively impacts employees' organizational commitment, sense of fulfillment, and autonomy. Enhancing work engagement can foster positive attitudes toward work and increase productivity. Second, work engagement is influenced by both personal resources and job resources, with job-related factors being more significant. It is particularly important for employees to experience success in their daily tasks and for their individual intentions to be respected.},
